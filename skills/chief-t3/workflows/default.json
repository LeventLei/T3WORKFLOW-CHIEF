{
  "$schema": "./workflow.schema.json",
  "schemaVersion": 1,
  "name": "chief-default",
  "title": "默认工作流",
  "description": "默认 Chief 工作流：摸底 → 实现 → 独立审查 → 验收。",
  "roles": {
    "scout": {
      "label": "scout",
      "purpose": "小范围只读摸底、长日志摘要",
      "delegateRole": "research",
      "access": "readonly",
      "reportLimit": 300,
      "target": {
        "provider": "pi",
        "model": "opencode-go/deepseek-v4.1-flash",
        "options": {
          "thinking": "high"
        }
      },
      "fallbacks": []
    },
    "navigator": {
      "label": "navigator",
      "purpose": "大范围索引或多模态分析；全库索引产出关键调用链与影响面摘要，细节写文件",
      "delegateRole": "research",
      "access": "readonly",
      "reportLimit": 500,
      "target": {
        "provider": "antigravity",
        "model": "gemini-3.8-flash",
        "options": {
          "thinking_level": "high"
        }
      },
      "fallbacks": [
        {
          "provider": "codex",
          "model": "gpt-6.1-sol",
          "options": {
            "reasoningEffort": "high"
          }
        }
      ]
    },
    "fast-dev": {
      "label": "fast-dev",
      "purpose": "规格明确的小改动",
      "delegateRole": "implementation",
      "access": "write",
      "target": {
        "provider": "pi",
        "model": "opencode-go/deepseek-v4.1-flash",
        "options": {
          "thinking": "high"
        }
      },
      "fallbacks": []
    },
    "dev": {
      "label": "dev",
      "purpose": "跨文件改动、疑难 bug，完成相关验证",
      "delegateRole": "implementation",
      "access": "write",
      "target": {
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "options": {
          "reasoningEffort": "high"
        }
      },
      "fallbacks": []
    },
    "reviewer": {
      "label": "reviewer",
      "purpose": "独立审查，给出 PASS / REJECT",
      "delegateRole": "review",
      "access": "readonly",
      "target": {
        "provider": "codex",
        "model": "gpt-6-astra",
        "options": {
          "reasoningEffort": "xhigh"
        }
      },
      "fallbacks": []
    },
    "architect": {
      "label": "architect",
      "purpose": "仅 S 级架构任务，产出 SPEC 并按约定评审",
      "delegateRole": "design",
      "access": "write",
      "target": {
        "provider": "codex",
        "model": "gpt-6-astra",
        "options": {
          "reasoningEffort": "xhigh"
        }
      },
      "fallbacks": []
    },
    "docs": {
      "label": "文档工作",
      "purpose": "文档整理",
      "delegateRole": "general",
      "access": "write",
      "target": {
        "provider": "pi",
        "model": "opencode-go/deepseek-v4.1-flash",
        "options": {
          "thinking": "low"
        }
      },
      "fallbacks": []
    }
  },
  "stages": [
    {
      "id": "recon",
      "enabled": true,
      "required": false,
      "roles": [
        "scout",
        "navigator"
      ],
      "note": "规格或影响面不清时先摸底"
    },
    {
      "id": "design",
      "enabled": true,
      "required": false,
      "roles": [
        "architect"
      ],
      "note": "仅 S 级架构任务"
    },
    {
      "id": "implement",
      "enabled": true,
      "required": true,
      "roles": [
        "fast-dev",
        "dev",
        "docs"
      ],
      "note": "按改动规模选择角色"
    },
    {
      "id": "review",
      "enabled": true,
      "required": false,
      "roles": [
        "reviewer"
      ],
      "note": "每次 review / recheck 都新派"
    }
  ],
  "limits": {
    "maxParallelWriters": 3,
    "maxReworkRounds": 2,
    "contractFileThreshold": 2
  }
}
